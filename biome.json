{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "useLiteralKeys": "off"
      },
      "style": { "useSelfClosingElements": "error" }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": { "formatter": { "enabled": true } }
}
